# Šablona pro lokální běh. Zkopírujte do .env.local (je v .gitignore)
# a doplňte klíč. Skutečné klíče sem NEPIŠTE — tento soubor je v gitu.

# --- AI poskytovatel: Spark (lokální DGX Spark přes LiteLLM bránu) ---
# Stejný princip jako Tradezer news-impact-agent (viz SPARK_INFRA_PLAN.md).
LLM_API_BASE=http://192.168.50.47:4000/v1
# Master klíč brány (na Sparku: ~/litellm/master_key.txt). Jiný klíč brána
# bez DB odmítne ("No connected db.").
LLM_API_KEY=
# Alias modelu v LiteLLM (heavy = gpt-oss:120b)
LLM_MODEL=heavy
# Timeout jednoho volání v sekundách. Změřeno: balíčky ~215 s, analýza
# potřeb ~117 s, chat ~19 s — 600 nechává rezervu i na opravné kolo.
LLM_TIMEOUT_S=600
# Okno kontextu Ollamy — balíčky posílají ~24k tokenů promptu. Na Sparku
# ověřeno, že se vejde bez ořezu; odkomentujte jen při ořezu (viz log
# "Spark usage" → prompt_tokens):
# LLM_NUM_CTX=65536

# --- Rollback na placené API (stejně jako Tradezer se samo NIKDY nepoužije) ---
# Jen při explicitním LLM_PROVIDER=anthropic:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-4-8
